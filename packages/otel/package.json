{
	"name": "@yaebal/otel",
	"version": "0.0.3",
	"description": "yaebal otel — opentelemetry tracing: a span per update, a child span per bot api call, custom spans via ctx.otel.",
	"type": "module",
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js"
		}
	},
	"files": [
		"lib",
		"src"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "node --test lib/*.test.js"
	},
	"peerDependencies": {
		"@opentelemetry/api": "^1.9.0",
		"@yaebal/core": "workspace:*"
	},
	"devDependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@types/node": "latest",
		"@yaebal/core": "workspace:*"
	},
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"telegram",
		"telegram-bot",
		"yaebal",
		"opentelemetry",
		"tracing",
		"otel"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/neverlane/yaebal",
		"directory": "packages/otel"
	},
	"publishConfig": {
		"access": "public"
	}
}
